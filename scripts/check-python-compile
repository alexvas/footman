#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python="$repo_root/.venv/bin/python"

if [ ! -x "$python" ]; then
    echo "error: $python is required; run 'uv sync --extra dev --locked' (see docs/python-checks.md)" >&2
    exit 127
fi

exec "$python" "$repo_root/scripts/python_checks.py" compile "$@"
